{
  "manifest_version": 3,
  "name": "TaskTimer for Modhesh",
  "version": "2.2.1",
  "description": "Logs your time on Modhesh from TaskTimer: links tasks by name and sends finished ones to your approver.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TaskTimer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://modhesh.social-eyez.com/*",
    "https://lxsjwiqhfotbowsgcexs.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://modhesh.social-eyez.com/*"
      ],
      "js": [
        "tasktimer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
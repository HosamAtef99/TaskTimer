{
  "manifest_version": 3,
  "name": "TaskTimer for Modhesh",
  "version": "1.2.0",
  "description": "Fills Modhesh's Log Time and Start Date from your TaskTimer tasks. You still press Save.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "64": "icons/64.png", "128": "icons/128.png" },
  "action": {
    "default_title": "TaskTimer",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://modhesh.social-eyez.com/*",
    "https://lxsjwiqhfotbowsgcexs.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://modhesh.social-eyez.com/*"],
      "js": ["tasktimer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
